# Signs portal/admin session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required in production, otherwise every restart signs everyone out.
JVH_AUTH_SECRET=

# Canonical public URL. Also flips robots.txt from "block all" to indexed.
# NEXT_PUBLIC_SITE_URL=https://jawadveterinary.pk

# Optional: enables the Drizzle/Postgres path and the POST health check.
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Optional: where the JSON document store lives (defaults to ./.data)
# JVH_DATA_DIR=/var/lib/jvh
